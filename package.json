{
  "name": "ai-session-manager",
  "version": "1.0.0",
  "description": "A local desktop session manager for Codex, Claude Code, and OpenClaw JSONL conversations.",
  "private": false,
  "type": "module",
  "bin": "server.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinJohn8/AI-Session-Manager.git"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js --open",
    "scan": "node server.js --scan",
    "build:win:server": "caxa --input . --output dist/AI-Session-Manager-server.exe --exclude \".git/**\" \"dist/**\" \"launcher/**\" -- \"{{caxa}}/node_modules/.bin/node\" \"{{caxa}}/server.js\"",
    "build:win:launcher": "dotnet publish launcher/AI-Session-Manager.Launcher.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:PublishReadyToRun=false -p:DebugType=None -p:DebugSymbols=false -o dist",
    "build:win": "npm run build:win:server && npm run build:win:launcher",
    "build:mac": "caxa --input . --output dist/AI-Session-Manager --exclude \".git/**\" \"dist/**\" -- \"{{caxa}}/node_modules/.bin/node\" \"{{caxa}}/server.js\" \"--open\"",
    "build:linux": "caxa --input . --output dist/AI-Session-Manager --exclude \".git/**\" \"dist/**\" -- \"{{caxa}}/node_modules/.bin/node\" \"{{caxa}}/server.js\" \"--open\""
  },
  "engines": {
    "node": ">=18"
  },
  "pkg": {
    "scripts": [
      "server.js"
    ],
    "assets": [
      "public/**/*"
    ]
  },
  "devDependencies": {
    "caxa": "^3.0.1"
  },
  "dependencies": {
    "sql.js": "^1.14.1"
  }
}
