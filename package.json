{
  "name": "ai-session-manager",
  "version": "1.0.0",
  "description": "A local desktop session manager for Codex, Claude Code, and OpenClaw JSONL conversations.",
  "private": false,
  "type": "module",
  "bin": "server.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinJohn8/AI-Session-Manager.git"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js --open",
    "scan": "node server.js --scan",
    "build:win": "caxa --input . --output dist/AI-Session-Manager.exe --exclude \".git/**\" \"dist/**\" -- \"{{caxa}}/node_modules/.bin/node\" \"{{caxa}}/server.js\" \"--open\"",
    "build:mac": "caxa --input . --output dist/AI-Session-Manager --exclude \".git/**\" \"dist/**\" -- \"{{caxa}}/node_modules/.bin/node\" \"{{caxa}}/server.js\" \"--open\"",
    "build:linux": "caxa --input . --output dist/AI-Session-Manager --exclude \".git/**\" \"dist/**\" -- \"{{caxa}}/node_modules/.bin/node\" \"{{caxa}}/server.js\" \"--open\""
  },
  "engines": {
    "node": ">=18"
  },
  "pkg": {
    "scripts": [
      "server.js"
    ],
    "assets": [
      "public/**/*"
    ]
  },
  "devDependencies": {
    "caxa": "^3.0.1"
  }
}
